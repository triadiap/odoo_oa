<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_odm_report_submission_approval_tree" model="ir.ui.view">
            <field name="name">odm.report.submission.approval.tree</field>
            <field name="model">odm.report.submission</field>
            <field name="arch" type="xml">
                <tree string="Report Submissions for Approval" create="false" delete="false">
                    <field name="receipt_code" optional="show"/>
                    <field name="name" optional="show"/>
                    <field name="deadline_time" optional="show"/>
                    <field name="state" optional="show"/>
                    <field name="write_uid" optional="show"/>
                    <field name="write_uid" string="Submitted By" optional="show"/>
                    <field name="write_date" string="Submission Date" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="report_submission_approval_form" model="ir.ui.view">
            <field name="name">odm.report.submission.approval.form</field>
            <field name="model">odm.report.submission</field>
            <field name="arch" type="xml">
                    <form action="false" create="false" edit="false" delete="false">
                        <header>
                                 <button id="button-pending" name="action_pending" string="Back To Review" class="btn-primary" type="object" states="completed"/>
                                 <button id="button-draft" name="action_draft" string="Set As Draft" class="btn-primary" type="object" states="approved"/>
                                 <button id="button-approve" name="action_approve" string="Approve" class="btn-primary" type="object" states="completed"/>
                                 <button name="action_print_ticket" string="Print Receipt" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'completed')]}"/>
                                 <field name="state" widget="statusbar" statusbar_visible="completed,approved"/>
                        </header>
                        <sheet>
                            <div class="oe_title">
                                <h1>
                                     <field name="receipt_code" readonly="1"/>
                                </h1>
                            </div>
                            <group>
                                <group>
                                     <field name="name" readonly="True"/>
                                     <field name="submission_freq" readonly="True"/>
                                      <field name="doc_type" readonly="True"/>
                                </group>
                                <group>
                                        <field name="deadline_time" readonly="True"/>
                                        <field name="parent_report_pic_ids" readonly="True" widget="many2many_tags"/>
                                        <field name="user_owner" string="Reviewers" readonly="True" widget="many2many_tags"/>
                                        <field name="is_need_approval" string="Need Approval" readonly="True" widget="boolean_toggle"/>
                                        <field name="name_approver" string="Approver" readonly="True" attrs="{'invisible': [('is_need_approval', '!=', True)]}"/>
                                        <field name="realization_date" readonly="True"/>
                                </group>
                            </group>
                            <group>
                                 <div>
                                     <h5>Description :</h5>
                                    <field name="report_description" widget="html" readonly="True"/>
                                </div>
                            </group>
                            <notebook>
                                <page string="Attachments">
                                    <field name="attachment_ids" readonly="True">
                                        <tree editable="bottom">
                                                <field name="name"/>
                                                <field name="uploaded_file"/>
                                        </tree>
                                    </field>
                                </page>
                            </notebook>
                        </sheet>
                         <div class="oe_chatter">
                            <field name="activity_ids"/>
                            <field name="message_ids"/>
                         </div>
                    </form>
            </field>
    </record>

        <record id="action_odm_report_submission_approval" model="ir.actions.act_window">
            <field name="name">Report Approval List</field>
            <field name="res_model">odm.report.submission</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('view_odm_report_submission_approval_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('report_submission_approval_form')})]"/>
            <field name="domain">[('name_approver', '=', uid), ('state', 'in', ['completed','approved']), ('is_need_approval', '=', True)]</field>
            <field name="context">{'is_review_view': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No report submissions found for approval.
                </p>
            </field>
        </record>
    </data>
</odoo>
