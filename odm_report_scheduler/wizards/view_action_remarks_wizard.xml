<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_action_remarks_form" model="ir.ui.view">
            <field name="name">odm.remarks.wizard.form</field>
            <field name="model">odm.remarks.wizard</field>
            <field name="arch" type="xml">
                <form string="Input Remarks">
                    <group>
                        <field name="action_remarks"/>
                    </group>
                    <footer>
                        <button string="Confirm" name="action_confirm" type="object" class="btn-primary" data-hotkey="q"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>